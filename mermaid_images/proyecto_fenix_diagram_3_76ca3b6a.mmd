graph TD
    classDef tema fill:#f9f9f9,stroke:#333,stroke-width:2px,font-weight:bold
    classDef accion fill:#bbdefb,stroke:#1976d2,stroke-width:2px
    classDef decision fill:#ce93d8,stroke:#6a1b9a,stroke-width:2px,stroke-dasharray: 4 2

    A[Proyecto Fenix: Redisenar plataforma e-commerce] -->|"requiere"| B[Adoptar arquitectura microservicios]
    B -->|"requiere aprobacion equipo arquitectura"| C[Definir API Gateway]
    C -->|"permite"| D[Desarrollar microservicio Usuarios]
    B -->|"conduce a"| E[Disenar nueva interfaz usuario]

    subgraph Busqueda_Semantica ["Decision secundaria: Busqueda Semantica"]
        F[Investigar soluciones de busqueda semantica]
        G[Evaluar dos proveedores de busqueda]
        H[Seleccionar tecnologia para microservicio Catalogo]
    end

    B -.->|"decision secundaria"| F
    F -->|"genera"| G
    G -->|"contribuye a"| H
    H -.->|"apoya a"| D

    B -->|"acuerda"| I[Establecer sprints quincenales para seguimiento]

    class A tema
    class B,F decision
    class C,D,E,G,H,I accion

    %% Estilos para el subgraph Busqueda_Semantica
    style Busqueda_Semantica fill:#fff9c4,stroke:#fbc02d,stroke-width:2px